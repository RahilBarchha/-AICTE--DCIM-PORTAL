# AICTE DCIM / Cybersecurity Portal Backend Configuration Template
PORT=5000

# Groq Cloud AI Configuration (Never commit private keys to version control)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Backend Security & API Authentication Secrets
SESSION_SECRET=change-me-to-a-strong-random-secret-key-32chars
TELEMETRY_API_KEY=change-me-to-a-secure-vm-telemetry-token
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
